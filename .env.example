# SQLite database (relative to prisma/schema.prisma)
DATABASE_URL="file:./colorbox.db"

# OpenAI-compatible endpoint. Leave the key empty to use local mode.
AI_API_KEY=
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4.1-mini"

# Maximum size per uploaded file in MB
MAX_UPLOAD_MB=20

# Server-only switch for the read-only public demo. Do not expose this as NEXT_PUBLIC_*.
PUBLIC_DEMO_MODE=false
