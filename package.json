{
  "name": "colorbox-ai",
  "version": "1.0.0",
  "private": false,
  "description": "AI-assisted packaging order review system for color box manufacturers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hql7-luo/colorbox-ai.git"
  },
  "scripts": {
    "dev": "prisma db push && prisma db seed && next dev",
    "build": "prisma generate && next build",
    "start": "prisma db push && prisma db seed && next start",
    "lint": "eslint src prisma --max-warnings=0",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "db:setup": "prisma db push && prisma db seed",
    "db:seed": "prisma db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.19.0",
    "clsx": "^2.1.1",
    "mammoth": "^1.11.0",
    "next": "^15.5.7",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
